# Copy this file to .env and fill in your own values.
PORT=3000
NODE_ENV=development
APP_NAME=WhatsApp Automation by MEHEDY
OWNER_NAME=MEHEDY
# Bangladesh number, international digits only, no + or spaces.
OWNER_NUMBER=
BOT_PREFIX=.
# Use a long random password. Change this before exposing the dashboard.
DASHBOARD_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=CHANGE_THIS_TO_A_RANDOM_64_HEX_CHARACTER_SECRET
# Railway PostgreSQL: paste the private DATABASE_URL from the Postgres service.
# Local development can run without PostgreSQL using the JSON fallback.
DATABASE_URL=
# On Railway, mount a persistent volume and set this path to its mount path.
SESSION_DIR=./sessions